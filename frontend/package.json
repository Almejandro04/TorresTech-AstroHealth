{
  "name": "@torrestech/astrohealth-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "npm@11.12.1",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:mocks": "node scripts/check-mocks.mjs",
    "check": "npm run check:contrast && npm run check:mocks && npm run check:series && npm run check:api",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "check:api": "node scripts/check-api.mjs",
    "check:series": "node scripts/check-series.mjs",
    "check:health": "node scripts/check-health.mjs"
  },
  "dependencies": {
    "@fontsource-variable/public-sans": "5.3.0",
